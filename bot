import os
import telebot
from flask import Flask
from threading import Thread

# Lấy token từ biến môi trường
API_TOKEN = '8540767077:AAH1WcAIaf3poZOx_aNVmTDZ0DoBEG0oJZo'
bot = telebot.TeleBot(API_TOKEN)

# Web server để keep alive
app = Flask('')

@app.route('/')
def home():
    return "🤖 Bot is running!"

def run():
    app.run(host='0.0.0.0', port=8080)

def keep_alive():
    t = Thread(target=run)
    t.start()

# Lệnh start
@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "👋 Hello! Bot deployed from GitHub on iPhone!")

# Lệnh help
@bot.message_handler(commands=['help'])
def send_help(message):
    help_text = """
Available commands:
/start - Start bot
/help - Show this help
/source - Show source code
"""
    bot.reply_to(message, help_text)

# Lệnh xem source code
@bot.message_handler(commands=['source'])
def show_source(message):
    bot.reply_to(message, "📦 Source: https://github.com/YOUR_USERNAME/telegram-bot")

if __name__ == '__main__':
    keep_alive()  # Khởi chạy web server
    print("🤖 Bot starting...")
    bot.polling(none_stop=True)
